# .env.local

# MongoDB（本地单节点 mongod，无鉴权；设计文档 §4.2 的 TLS 仅用于 uat/prod）
MONGODB_URI=mongodb://127.0.0.1:27017/ai_blog
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# Redis（本地 redis-server，无密码；uat/prod 由运维提供 REDIS_PASSWORD，不入库）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=local:
